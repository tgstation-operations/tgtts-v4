#version 460
#extension GL_GOOGLE_include_directive : require
// out = residual + the PARTS partial products local_partial wrote, summed in f32 in the order
// of their chunks: the residual add after o_proj or down_proj. The residual and out are LEN
// values, the partial products `[PARTS][LEN]`.
#include "common.glsl"

layout(constant_id = 2) const uint LEN = 22528;
layout(constant_id = 3) const uint PARTS = 4;

layout(std430, binding = 0) readonly buffer Partial { float partial[]; };
layout(std430, binding = 1) readonly buffer Residual { float16_t residual[]; };
layout(std430, binding = 2) writeonly buffer Out { float16_t out_[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= LEN) {
        return;
    }
    float sum = 0.0;
    [[unroll]] for (uint p = 0; p < PARTS; p++) {
        sum += partial[p * LEN + i];
    }
    out_[i] = float16_t(float(residual[i]) + sum);
}
