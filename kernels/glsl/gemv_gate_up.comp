#version 460
#extension GL_GOOGLE_include_directive : require
// out = SiLU(gate) * up, with gate and up the two halves of W RMSNorm(x): the MLP's gate_up_proj
// and what comes before and after it. W is 2 INNER x K, the gate's rows first; a subgroup takes
// PAIRS rows of the gate and the same rows of up.
#include "common.glsl"

layout(constant_id = 2) const uint K = 2048;
layout(constant_id = 3) const uint INNER = 6144;
layout(constant_id = 4) const float EPS = 1e-5;
layout(constant_id = 5) const uint PAIRS = 1;

const uint ROWS = 2 * PAIRS;

layout(std430, binding = 0) readonly buffer X { float16_t x[]; };
layout(std430, binding = 1) readonly buffer G { float16_t g[]; };
layout(std430, binding = 2) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 3) writeonly buffer Out { float16_t out_[]; };

#include "gemv.glsl"
#include "norm.glsl"

void main() {
    float scale = rms_scale(EPS);
    for (uint i = gl_LocalInvocationID.x; i < K; i += WORKGROUP) {
        store_x(i, normed(i, scale));
    }
    barrier();
    uint first = (gl_WorkGroupID.x * SUBGROUPS + gl_SubgroupID) * PAIRS;
    uint rows[ROWS];
    [[unroll]] for (uint p = 0; p < PAIRS; p++) {
        rows[2 * p] = first + p;
        rows[2 * p + 1] = INNER + first + p;
    }
    float sums[ROWS];
    dot_rows(rows, sums);
    if (gl_SubgroupInvocationID == 0) {
        [[unroll]] for (uint p = 0; p < PAIRS; p++) {
            float gate = sums[2 * p];
            out_[first + p] = float16_t(gate / (1.0 + exp(-gate)) * sums[2 * p + 1]);
        }
    }
}
