#version 460
#extension GL_GOOGLE_include_directive : require
// One Euler step of the sampler from the local DiT's last hidden states, by one workgroup: the
// DiT's final norm of the FRAMES tokens at FIRST of each of its two sequences, the conditional
// and the unconditional; out_proj's velocities from them; and x -= DT times the velocity
// guided as CFG-Zero* guides it, the unconditional velocity scaled to best match the
// conditional one and the difference from it scaled by the guidance. A cluster takes ROWS of
// out_proj's CHANNELS rows. h is `[2][T][K]`; x is `[CHANNELS][FRAMES]`, as the sampler keeps
// it.
#include "common.glsl"

layout(constant_id = 2) const uint K = 1024;
layout(constant_id = 3) const uint T = 11;
layout(constant_id = 4) const uint FIRST = 7;
layout(constant_id = 5) const uint FRAMES = 4;
layout(constant_id = 6) const uint CHANNELS = 64;
layout(constant_id = 7) const float EPS = 1e-5;
layout(constant_id = 8) const float DT = 0.1;
layout(constant_id = 9) const uint ROWS = 4;

const uint KC = K;
const uint BLOCKS = 1;
const uint M = 2 * FRAMES;
const uint LEN = CHANNELS * FRAMES;

layout(std430, binding = 0) readonly buffer X { uvec4 x[]; };
layout(std430, binding = 1) readonly buffer G { uvec4 g[]; };
// [CHANNELS][K]
layout(std430, binding = 2) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 3) readonly buffer Bias { float16_t bias[]; };
// The temperature, then the guidance scale.
layout(std430, binding = 4) readonly buffer Sampling { float temperature; float cfg; };
layout(std430, binding = 5) buffer State { float state[]; };

#define TOKEN_ROW(m) ((m) / FRAMES * T + FIRST + (m) % FRAMES)
#include "gemm.glsl"
#include "gemm_norm.glsl"

// The two sequences' velocities, `[2][CHANNELS][FRAMES]`.
shared float velocity[2 * LEN];
shared float partial_dot[SUBGROUPS];
shared float partial_norm[SUBGROUPS];

void stage(uint chunk) {
    if (chunk == 0) {
        norm_scales();
    }
    stage_normed(chunk);
}

void rows_of(uint block, out uint rows[ROWS]) {
    [[unroll]] for (uint r = 0; r < ROWS; r++) {
        rows[r] = cluster_id() * ROWS + r;
    }
}

void epilogue(uint rows[ROWS], float acc[SUMS]) {
    [[unroll]] for (uint r = 0; r < ROWS; r++) {
        float sums[PER_LANE];
        mine(acc, r, sums);
        [[unroll]] for (uint t = 0; t < PER_LANE; t++) {
            uint m = t * CLUSTER + cluster_lane();
            if (m < M) {
                uint at = m / FRAMES * LEN + rows[r] * FRAMES + m % FRAMES;
                velocity[at] = sums[t] + float(bias[rows[r]]);
            }
        }
    }
}

void main() {
    run();
    barrier();
    float dot_ = 0.0;
    float norm = 0.0;
    for (uint i = gl_LocalInvocationID.x; i < LEN; i += WORKGROUP) {
        dot_ += velocity[i] * velocity[LEN + i];
        norm += velocity[LEN + i] * velocity[LEN + i];
    }
    dot_ = subgroupAdd(dot_);
    norm = subgroupAdd(norm);
    if (subgroupElect()) {
        partial_dot[gl_SubgroupID] = dot_;
        partial_norm[gl_SubgroupID] = norm;
    }
    barrier();
    dot_ = 0.0;
    norm = 0.0;
    for (uint s = 0; s < SUBGROUPS; s++) {
        dot_ += partial_dot[s];
        norm += partial_norm[s];
    }
    float alpha = dot_ / (norm + 1e-8);
    for (uint i = gl_LocalInvocationID.x; i < LEN; i += WORKGROUP) {
        float scaled = velocity[LEN + i] * alpha;
        float guided = scaled + cfg * (velocity[i] - scaled);
        state[i] -= guided * DT;
    }
}
