#version 460
#extension GL_GOOGLE_include_directive : require
// out = residual + W x for each of the M tokens of a local stack: o_proj and down_proj with the
// residual add after them. W is N x K, ROWS rows to a cluster and BLOCKS blocks of them to a
// workgroup; the residual and out are `[M][N]`, x `[M][K]`.
#include "common.glsl"

layout(constant_id = 2) const uint K = 2048;
layout(constant_id = 3) const uint KC = 1024;
layout(constant_id = 4) const uint M = 22;
layout(constant_id = 5) const uint N = 1024;
layout(constant_id = 6) const uint ROWS = 1;
layout(constant_id = 7) const uint BLOCKS = 1;

layout(std430, binding = 0) readonly buffer X { uvec4 x[]; };
layout(std430, binding = 1) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 2) readonly buffer Residual { float16_t residual[]; };
layout(std430, binding = 3) writeonly buffer Out { float16_t out_[]; };

#include "gemm.glsl"

void stage(uint chunk) {
    uvec4 tokens[STAGED];
    [[unroll]] for (uint i = 0; i < STAGED; i++) {
        uint v = i * WORKGROUP + gl_LocalInvocationID.x;
        if (v < M * (KC / 8)) {
            tokens[i] = x[staged_at(v, chunk)];
        }
    }
    [[unroll]] for (uint i = 0; i < STAGED; i++) {
        uint v = i * WORKGROUP + gl_LocalInvocationID.x;
        if (v < M * (KC / 8)) {
            xs[v] = tokens[i];
        }
    }
}

void rows_of(uint block, out uint rows[ROWS]) {
    uint first = (block * CLUSTERS + cluster_id()) * ROWS;
    [[unroll]] for (uint r = 0; r < ROWS; r++) {
        rows[r] = first + r;
    }
}

void epilogue(uint rows[ROWS], float acc[SUMS]) {
    [[unroll]] for (uint r = 0; r < ROWS; r++) {
        float sums[PER_LANE];
        mine(acc, r, sums);
        [[unroll]] for (uint t = 0; t < PER_LANE; t++) {
            uint m = t * CLUSTER + cluster_lane();
            if (m < M) {
                uint at = m * N + rows[r];
                out_[at] = float16_t(float(residual[at]) + sums[t]);
            }
        }
    }
}

void main() {
    run();
}
