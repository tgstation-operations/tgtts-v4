#version 460
#extension GL_GOOGLE_include_directive : require
// The attention's input side for the M tokens of a local stack, sequences of T tokens each: q,
// k and v = W RMSNorm(x), q and k rotated by RoPE at each token's place in its sequence. W is
// upstream's q_proj, k_proj and v_proj joined along their outputs, HEADS + 2 KV_HEADS heads of
// HEAD_DIM rows; a cluster takes PAIRS pairs of rows i and i + HEAD_DIM / 2 of one head, the
// pairs RoPE rotates together. x is `[M][K]`; q, k and v are `[M][heads][HEAD_DIM]`; the
// rotation's cosines and sines are `[T][HEAD_DIM / 2]`.
#include "common.glsl"

layout(constant_id = 2) const uint K = 1024;
layout(constant_id = 3) const uint M = 22;
layout(constant_id = 4) const uint T = 11;
layout(constant_id = 5) const uint HEADS = 16;
layout(constant_id = 6) const uint KV_HEADS = 2;
layout(constant_id = 7) const uint HEAD_DIM = 128;
layout(constant_id = 8) const float EPS = 1e-5;
layout(constant_id = 9) const uint PAIRS = 1;
layout(constant_id = 10) const uint KC = 1024;
layout(constant_id = 11) const uint SLOTS = 1024;
const uint ROWS = 2 * PAIRS;
const bool SPLIT = false;
const uint HALF = HEAD_DIM / 2;

layout(std430, binding = 0) readonly buffer X { uvec4 x[]; };
layout(std430, binding = 1) readonly buffer G { uvec4 g[]; };
layout(std430, binding = 2) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 3) readonly buffer Cos { float cos_[]; };
layout(std430, binding = 4) readonly buffer Sin { float sin_[]; };
layout(std430, binding = 5) writeonly buffer Q { float16_t q[]; };
layout(std430, binding = 6) writeonly buffer Key { float16_t k[]; };
layout(std430, binding = 7) writeonly buffer Value { float16_t v[]; };

#include "gemm.glsl"
#include "gemm_norm.glsl"

void stage(uint chunk) {
    if (chunk == 0) {
        norm_scales();
    }
    stage_normed(chunk);
}

void rows_of(uint slot, out uint rows[ROWS]) {
    uint first = slot * PAIRS;
    [[unroll]] for (uint p = 0; p < PAIRS; p++) {
        uint pair = first + p;
        uint row = pair / HALF * HEAD_DIM + pair % HALF;
        rows[2 * p] = row;
        rows[2 * p + 1] = row + HALF;
    }
}

void epilogue(uint rows[ROWS], float acc[SUMS]) {
    [[unroll]] for (uint p = 0; p < PAIRS; p++) {
        uint head = rows[2 * p] / HEAD_DIM;
        uint i = rows[2 * p] % HEAD_DIM;
        float a[PER_LANE], b[PER_LANE];
        mine(acc, 2 * p, a);
        mine(acc, 2 * p + 1, b);
        [[unroll]] for (uint t = 0; t < PER_LANE; t++) {
            uint m = t * CLUSTER + cluster_lane();
            if (m >= M) {
                continue;
            }
            if (head >= HEADS + KV_HEADS) {
                uint at = (m * KV_HEADS + head - HEADS - KV_HEADS) * HEAD_DIM + i;
                v[at] = float16_t(a[t]);
                v[at + HALF] = float16_t(b[t]);
                continue;
            }
            // As upstream: x cos + rotate_half(x) sin.
            float c = cos_[m % T * HALF + i];
            float s = sin_[m % T * HALF + i];
            float ra = a[t] * c - b[t] * s;
            float rb = b[t] * c + a[t] * s;
            if (head < HEADS) {
                uint at = (m * HEADS + head) * HEAD_DIM + i;
                q[at] = float16_t(ra);
                q[at + HALF] = float16_t(rb);
            } else {
                uint at = (m * KV_HEADS + head - HEADS) * HEAD_DIM + i;
                k[at] = float16_t(ra);
                k[at + HALF] = float16_t(rb);
            }
        }
    }
}

void main() {
    run();
}
