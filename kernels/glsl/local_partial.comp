#version 460
#extension GL_GOOGLE_include_directive : require
// W x over each of the PARTS parts of K columns for each of the M tokens of a local stack:
// o_proj and down_proj, cut along their columns so that many workgroups share out few rows, for
// local_add_norm to join with the residual. W is N x K, a unit RT tiles of its rows; x is
// `[M][K]`, and the partial products `[PARTS][blocks * BM][N]` in f32, the tokens past M left
// as zero as they come out.
#include "common.glsl"

layout(constant_id = 2) const uint K = 4096;
layout(constant_id = 3) const uint M = 22;
layout(constant_id = 4) const uint N = 1024;
layout(constant_id = 5) const uint RT = 1;
layout(constant_id = 6) const uint PARTS = 4;
layout(constant_id = 7) const uint KC = 512;
layout(constant_id = 8) const uint BM = 32;
layout(constant_id = 9) const uint DEPTH = 4;
const uint UNITS = N / 16 / RT;

layout(std430, binding = 0) readonly buffer X { uvec4 x[]; };
layout(std430, binding = 1) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 2) writeonly buffer Partial { float partial[]; };

#include "mma.glsl"

uint unit_row(uint unit, uint r) {
    return (unit * RT + r) * 16;
}

void epilogue(uint unit, uint block, TILE_C acc[TILES]) {
    uint tokens = gl_NumWorkGroups.z * BM;
    [[unroll]] for (uint r = 0; r < RT; r++) {
        [[unroll]] for (uint t = 0; t < TT; t++) {
            uint m = block * BM + t * 16;
            coopMatStore(acc[r * TT + t], partial, (gl_WorkGroupID.y * tokens + m) * N
                + unit_row(unit, r), N, gl_CooperativeMatrixLayoutColumnMajor);
        }
    }
}

void main() {
    run();
}
