#version 460
#extension GL_GOOGLE_include_directive : require
// out = RMSNorm(x) with gain g for each token of a local stack: the first layer's input norm.
// Workgroup m takes token m. x and out are `[M][N]`.
#include "common.glsl"

layout(constant_id = 2) const uint N = 1024;
layout(constant_id = 3) const float EPS = 1e-5;

const uint VECTORS = N / 8;
const uint PER = (VECTORS + WORKGROUP - 1) / WORKGROUP;

layout(std430, binding = 0) readonly buffer X { uvec4 x[]; };
layout(std430, binding = 1) readonly buffer G { uvec4 g[]; };
layout(std430, binding = 2) writeonly buffer Out { uvec4 out_[]; };

shared float squares_of[SUBGROUPS];

void main() {
    uint m = gl_WorkGroupID.x;
    vec4 lo[PER], hi[PER];
    float squares = 0.0;
    [[unroll]] for (uint i = 0; i < PER; i++) {
        uint v = i * WORKGROUP + gl_LocalInvocationID.x;
        if (v < VECTORS) {
            unpack8(x[m * VECTORS + v], lo[i], hi[i]);
            squares += dot(lo[i], lo[i]) + dot(hi[i], hi[i]);
        }
    }
    squares = subgroupAdd(squares);
    if (subgroupElect()) {
        squares_of[gl_SubgroupID] = squares;
    }
    barrier();
    float total = 0.0;
    for (uint s = 0; s < SUBGROUPS; s++) {
        total += squares_of[s];
    }
    float scale = 1.0 / sqrt(total / float(N) + EPS);
    [[unroll]] for (uint i = 0; i < PER; i++) {
        uint v = i * WORKGROUP + gl_LocalInvocationID.x;
        if (v < VECTORS) {
            vec4 glo, ghi;
            unpack8(g[v], glo, ghi);
            out_[m * VECTORS + v] = pack8(lo[i] * scale * glo, hi[i] * scale * ghi);
        }
    }
}
