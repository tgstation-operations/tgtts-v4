#version 460
#extension GL_GOOGLE_include_directive : require
// out[OFFSET + i] = act(W x + bias)[i] for each of BATCH rows: a linear layer between VoxCPM2's
// LMs, W N x (K0 + K1) against x0's K0 values followed by x1's K1, as upstream concatenates
// fusion_concat_proj's input. A subgroup takes one row of W.
#include "common.glsl"

layout(constant_id = 2) const uint K0 = 2048;
layout(constant_id = 3) const uint K1 = 0;
layout(constant_id = 4) const uint N = 2048;
layout(constant_id = 5) const uint OFFSET = 0;
// 0: none; 1: SiLU; 2: the scalar quantizer's, tanh rounded to a multiple of 1 / LEVELS.
layout(constant_id = 6) const uint ACT = 0;
layout(constant_id = 7) const float LEVELS = 9.0;
layout(constant_id = 8) const uint BATCH = 1;
layout(constant_id = 9) const uint SPAN = 0;
// The length of a row of out, which holds OFFSET + N values of it at least.
layout(constant_id = 10) const uint STRIDE = 2048;

const uint K = K0 + K1;
const uint ROWS = 1;
// The layers between the stacks are a hundredth of a patch's time: no loads ahead.
const uint AHEAD = 0;

// [BATCH][K0] and [BATCH][K1]
layout(std430, binding = 0) readonly buffer X { uvec4 x[]; };
layout(std430, binding = 1) readonly buffer X1 { uvec4 x1[]; };
layout(std430, binding = 2) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 3) readonly buffer Bias { float16_t bias[]; };
// [BATCH][STRIDE]
layout(std430, binding = 4) writeonly buffer Out { float16_t out_[]; };

#include "gemv.glsl"

uvec4 x_at(uint b, uint v) {
    return v < K0 / 8 ? x[b * (K0 / 8) + v] : x1[b * (K1 / 8) + v - K0 / 8];
}

void main() {
    uint row = gl_WorkGroupID.x * SUBGROUPS + gl_SubgroupID;
    // A subgroup past the last row sums that row again: every subgroup stages the vectors.
    uint rows[ROWS];
    rows[0] = min(row, N - 1);
    float sums[SUMS];
    dot_rows(rows, sums);
    if (gl_SubgroupInvocationID != 0 || row >= N) {
        return;
    }
    [[unroll]] for (uint b = 0; b < BATCH; b++) {
        float v = sums[b] + float(bias[row]);
        if (ACT == 1) {
            v = v / (1.0 + exp(-v));
        } else if (ACT == 2) {
            // tanh from exp, whose precision Vulkan bounds; tanh's own is only inherited from
            // sinh / cosh, which overflow.
            float t = 1.0 - 2.0 / (exp(2.0 * abs(v)) + 1.0);
            v = roundEven(sign(v) * t * LEVELS) / LEVELS;
        }
        out_[b * STRIDE + OFFSET + row] = float16_t(v);
    }
}
