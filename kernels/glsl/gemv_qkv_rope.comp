#version 460
#extension GL_GOOGLE_include_directive : require
// The attention's input side for each of BATCH rows: q, k and v = W RMSNorm(x), q and k
// rotated by RoPE at the row's position, k and v written into the row's cache slot there. W is
// upstream's q_proj, k_proj and v_proj joined along their outputs: HEADS + 2 KV_HEADS heads of
// HEAD_DIM rows. A subgroup takes PAIRS pairs of rows i and i + HEAD_DIM / 2 of one head, the
// pairs RoPE rotates together, so the rotation needs nothing from another subgroup.
//
// The positions and slots are read from `at` on every run (batch.glsl). The rotation's cosines
// and sines are tables of HEAD_DIM / 2 per position, computed by the host as upstream's
// LongRoPE computes them.
#include "common.glsl"

layout(constant_id = 2) const uint K = 2048;
layout(constant_id = 3) const uint HEADS = 16;
layout(constant_id = 4) const uint KV_HEADS = 2;
layout(constant_id = 5) const uint HEAD_DIM = 128;
layout(constant_id = 6) const uint CAPACITY = 1024;
layout(constant_id = 7) const float EPS = 1e-5;
layout(constant_id = 8) const uint PAIRS = 1;
layout(constant_id = 9) const uint AHEAD = 0;
// Whether q and k are rotated: VoxCPM2's residual LM attends without RoPE.
layout(constant_id = 10) const bool ROPE = true;
layout(constant_id = 11) const uint BATCH = 1;
layout(constant_id = 12) const uint SLOTS = 1;
layout(constant_id = 13) const uint SPAN = 0;
layout(constant_id = 14) const uint NORM_WIDTH = 64;

const uint ROWS = 2 * PAIRS;
const uint HALF = HEAD_DIM / 2;

// [BATCH][K]
layout(std430, binding = 0) readonly buffer X { uvec4 x[]; };
layout(std430, binding = 1) readonly buffer G { uvec4 g[]; };
layout(std430, binding = 2) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 3) readonly buffer Cos { float cos_[]; };
layout(std430, binding = 4) readonly buffer Sin { float sin_[]; };
layout(std430, binding = 5) readonly buffer At { uint at_[]; };
// [BATCH][HEADS][HEAD_DIM]
layout(std430, binding = 6) writeonly buffer Q { float16_t q[]; };
// [SLOTS][KV_HEADS][CAPACITY][HEAD_DIM]
layout(std430, binding = 7) writeonly buffer KCache { float16_t k_cache[]; };
layout(std430, binding = 8) writeonly buffer VCache { float16_t v_cache[]; };

#include "batch.glsl"
#include "gemv.glsl"
#include "norm.glsl"
#include "gemv_norm.glsl"

void main() {
    uint first = (gl_WorkGroupID.x * SUBGROUPS + gl_SubgroupID) * PAIRS;
    uint rows[ROWS];
    [[unroll]] for (uint p = 0; p < PAIRS; p++) {
        uint pair = first + p;
        uint row = pair / HALF * HEAD_DIM + pair % HALF;
        rows[2 * p] = row;
        rows[2 * p + 1] = row + HALF;
    }
    prefetch(rows);
    norm_scales(EPS);
    float sums[SUMS];
    dot_rows(rows, sums);
    if (gl_SubgroupInvocationID != 0) {
        return;
    }
    [[unroll]] for (uint b = 0; b < BATCH; b++) {
        uint pos, slot;
        if (!placed(b, pos, slot)) {
            continue;
        }
        [[unroll]] for (uint p = 0; p < PAIRS; p++) {
            uint pair = first + p;
            uint head = pair / HALF;
            uint i = pair % HALF;
            float a = sums[b * ROWS + 2 * p];
            float c = sums[b * ROWS + 2 * p + 1];
            if (head >= HEADS + KV_HEADS) {
                uint kv = head - HEADS - KV_HEADS;
                uint at = ((slot * KV_HEADS + kv) * CAPACITY + pos) * HEAD_DIM + i;
                v_cache[at] = float16_t(a);
                v_cache[at + HALF] = float16_t(c);
                continue;
            }
            float ra = a;
            float rc = c;
            if (ROPE) {
                // As upstream: x cos + rotate_half(x) sin.
                float co = cos_[pos * HALF + i];
                float si = sin_[pos * HALF + i];
                ra = a * co - c * si;
                rc = c * co + a * si;
            }
            if (head < HEADS) {
                uint at = (b * HEADS + head) * HEAD_DIM + i;
                q[at] = float16_t(ra);
                q[at + HALF] = float16_t(rc);
            } else {
                uint kv = head - HEADS;
                uint at = ((slot * KV_HEADS + kv) * CAPACITY + pos) * HEAD_DIM + i;
                k_cache[at] = float16_t(ra);
                k_cache[at + HALF] = float16_t(rc);
            }
        }
    }
}
