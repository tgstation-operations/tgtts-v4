#version 460
#extension GL_GOOGLE_include_directive : require
// out = SiLU(gate) * up for each of the M tokens of a local stack, with gate and up the two
// halves of W x, x the tokens after the post-attention norm: the MLP's gate_up_proj and what
// comes after it. W is 2 INNER x K, the gate's rows first; a unit is PAIRS tiles of rows of the
// gate and the same rows of up. x is `[M][K]`, out `[M][INNER]`.
#include "common.glsl"

layout(constant_id = 2) const uint K = 1024;
layout(constant_id = 3) const uint M = 22;
layout(constant_id = 4) const uint INNER = 4096;
layout(constant_id = 5) const uint PAIRS = 1;
layout(constant_id = 6) const uint KC = 512;
layout(constant_id = 7) const uint BM = 32;
layout(constant_id = 8) const uint DEPTH = 4;
const uint RT = 2 * PAIRS;
const uint PARTS = 1;
const uint UNITS = INNER / 16 / PAIRS;

layout(std430, binding = 0) readonly buffer X { uvec4 x[]; };
layout(std430, binding = 1) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 2) writeonly buffer Out { float16_t out_[]; };

#include "mma.glsl"

// Each subgroup's pair of tiles of C^T on their way out, `[2][16 tokens][16 rows]`.
shared float pair_of[SUBGROUPS * 512];

uint unit_row(uint unit, uint r) {
    return (unit * PAIRS + r / 2) * 16 + r % 2 * INNER;
}

void epilogue(uint unit, uint block, TILE_C acc[TILES]) {
    uint base = gl_SubgroupID * 512;
    [[unroll]] for (uint p = 0; p < PAIRS; p++) {
        uint row = unit_row(unit, 2 * p);
        [[unroll]] for (uint t = 0; t < TT; t++) {
            subgroupBarrier();
            coopMatStore(acc[2 * p * TT + t], pair_of, base, 16,
                gl_CooperativeMatrixLayoutColumnMajor);
            coopMatStore(acc[(2 * p + 1) * TT + t], pair_of, base + 256, 16,
                gl_CooperativeMatrixLayoutColumnMajor);
            subgroupBarrier();
            [[unroll]] for (uint j = 0; j < 256 / SUBGROUP; j++) {
                uint e = j * SUBGROUP + gl_SubgroupInvocationID;
                uint m = block * BM + t * 16 + e / 16;
                if (m < M) {
                    float gate = pair_of[base + e];
                    float up = pair_of[base + 256 + e];
                    out_[m * INNER + row + e % 16] = float16_t(gate / (1.0 + exp(-gate)) * up);
                }
            }
        }
    }
}

void main() {
    run();
}
